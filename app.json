{
  "expo": {
    "name": "KPSS Quiz",
    "slug": "rehberkpss",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "rehberkpss",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rehberkpss.app",
      "infoPlist": {
        "CFBundleDisplayName": "KPSS Quiz",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.456375332468-0961uefkjdtmcho90cif88f1gg3anfjk"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rehberkpss.app",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6324be1c-25c7-412e-af56-d3c778aab7d7"
      }
    }
  }
}
