+// PATCH(kpssmobil): corrupt storage (nil manifest entries, broken files) used to raise an
+// NSException from these methods; RN 0.81's ObjC->JS exception conversion then corrupts the
+// Hermes runtime and crash-loops the app at startup. Instead: report the error through the
+// normal callback path and wipe the unreadable storage so the next launch starts clean.
+- (void)_recoverFromCorruptStorage
+{
+    @try {
+        [_manifest removeAllObjects];
+        [RCTGetCache() removeAllObjects];
+        RCTDeleteStorageDirectory();
+    } @catch (NSException *__unused ignored) {
+    }
+}
+
+- (NSDictionary *)_errorFromException:(NSException *)exception
+{
+    NSString *reason = exception.reason ?: @"Unknown storage exception";
+    return RCTMakeError([NSString stringWithFormat:@"Storage recovered from exception: %@", reason],
+                        nil,
+                        nil);
+}
+
