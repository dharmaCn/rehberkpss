rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profilleri
    match /users/{uid} {
      // Herkes profil okuyabilir (sıralama için gerekli)
      allow read: if request.auth != null;

      // Sadece kendi profilini yazabilir
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && validUserData(request.resource.data);

      // Güncelleme: sadece izin verilen alanlar
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && validUserUpdate(request.resource.data, resource.data);

      // Kullanıcı yalnızca kendi profilini silebilir (hesap silme)
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Yanlışlarım defteri (kullanıcının kendi alt koleksiyonu)
      match /wrongQuestions/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Eser sorularına verilen cevaplar (kullanıcının kendi alt koleksiyonu)
      match /artAnswers/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Arkadaş listesi: sahibi veya karşı taraf yazabilir (kabul eden iki tarafa
      // da yazar), silme de aynı şekilde (arkadaşlıktan çıkma iki taraflı).
      match /friends/{friendUid} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid || request.auth.uid == friendUid);
        allow create: if request.auth != null
                      && (request.auth.uid == uid || request.auth.uid == friendUid)
                      && request.resource.data.uid == friendUid;
        allow delete: if request.auth != null
                      && (request.auth.uid == uid || request.auth.uid == friendUid);
        allow update: if false;
      }
    }

    // Arkadaşlık istekleri — doküman id: fromUid_toUid
    match /friendRequests/{requestId} {
      // get: doküman olmayabilir (durum kontrolü), o yüzden id üzerinden kontrol edilir
      allow get: if request.auth != null
                 && (requestId.matches(request.auth.uid + '_.*')
                     || requestId.matches('.*_' + request.auth.uid));
      allow list: if request.auth != null
                  && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
                    && requestId == request.auth.uid + '_' + request.resource.data.to
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.from != request.resource.data.to
                    && request.resource.data.status == 'pending'
                    && request.resource.data.fromName is string
                    && request.resource.data.fromName.size() <= 100;
      // Gönderen iptal edebilir, alıcı kabul/ret sonrası silebilir
      allow delete: if request.auth != null
                    && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if false;
    }

    // Eser sorusu istatistik sayaçları (toplam / doğru). Sosyal kanıt için herkes okur,
    // giriş yapmış kullanıcı sadece sayaçları artırabilir.
    match /artStats/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.keys().hasOnly(['total', 'correct'])
                   && request.resource.data.total is int
                   && request.resource.data.correct is int
                   && (!('total' in resource.data) || request.resource.data.total >= resource.data.total);
    }

    // Ders bazlı günlük quiz sonuçları
    match /categoryResults/{resultId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && validCategoryResultData(request.resource.data);

      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Günlük quiz sonuçları
    match /results/{resultId} {
      // Herkes sonuçları okuyabilir (sıralama için)
      allow read: if request.auth != null;

      // Kendi sonucunu sadece bir kez yazabilir (güncelleme yok)
      allow create: if request.auth != null
                    && resultId == request.auth.uid + '_' + request.resource.data.date
                    && request.resource.data.uid == request.auth.uid
                    && validResultData(request.resource.data);

      // Kendi günlük sonucunu güncelleyebilir (kategori puanı ekleme + ana quiz tamamlama).
      // Kendi dokümanı olduğu sürece serbest; uid değişmez, puan düşmez.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.score >= resource.data.score;
      // Kullanıcı yalnızca kendi sonuçlarını silebilir (hesap silme)
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Düellolar — meydan okuyan (from) kendi sonucuyla oluşturur,
    // rakip (to) tamamlayarak sonucunu ekler. Sadece taraflar okuyabilir.
    match /duels/{duelId} {
      allow get: if request.auth != null
                 && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if request.auth != null
                  && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.from != request.resource.data.to
                    && request.resource.data.status == 'pending'
                    && request.resource.data.category in ['tarih', 'cografya', 'vatandaslik', 'guncel', 'karisik']
                    && request.resource.data.questionIds is list
                    && request.resource.data.questionIds.size() == 5
                    && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 100
                    && request.resource.data.toName is string && request.resource.data.toName.size() <= 100
                    && validDuelSide(request.resource.data.fromScore, request.resource.data.fromCorrect);

      allow update: if request.auth != null
                    && request.resource.data.from == resource.data.from
                    && request.resource.data.to == resource.data.to
                    && request.resource.data.questionIds == resource.data.questionIds
                    && request.resource.data.fromScore == resource.data.fromScore
                    && (
                      // Rakip tamamlıyor
                      (request.auth.uid == resource.data.to
                       && resource.data.status == 'pending'
                       && request.resource.data.status == 'completed'
                       && validDuelSide(request.resource.data.toScore, request.resource.data.toCorrect))
                      // Meydan okuyan: süre doldu işareti veya "sonucu gördüm" bayrağı
                      || (request.auth.uid == resource.data.from
                          && (request.resource.data.status == resource.data.status
                              || (resource.data.status == 'pending' && request.resource.data.status == 'expired')))
                    );

      allow delete: if request.auth != null
                    && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Uygulama konfig dokümanları — sürüm bilgisi vb. Herkes okur, kimse yazamaz
    // (yazma Firebase Console üzerinden manuel yapılır).
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Soru hata bildirimleri — kullanıcı sadece kendi adına rapor oluşturabilir,
    // okuma/güncelleme/silme yok (geliştirici Firebase Console üzerinden inceler)
    match /questionReports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && validQuestionReportData(request.resource.data);
      allow read, update, delete: if false;
    }
  }

  // Kullanıcı verisi doğrulama
  function validUserData(data) {
    return data.keys().hasAll(['uid', 'displayName', 'email', 'totalScore', 'quizCount', 'bestDayScore'])
      && data.uid is string
      && data.displayName is string && data.displayName.size() <= 100
      && data.email is string
      && data.totalScore == 0
      && data.quizCount == 0
      && data.bestDayScore == 0;
  }

  // Güncelleme için izin verilen alanlar
  function validUserUpdate(newData, oldData) {
    return newData.uid == oldData.uid
      && newData.email == oldData.email
      && newData.totalScore >= oldData.totalScore
      && newData.quizCount >= oldData.quizCount
      && newData.totalScore <= oldData.totalScore + 1620; // maks ana quiz (1500) + 4 ders quizi (4×30=120)
  }

  // Kategori quiz sonucu doğrulama
  function validCategoryResultData(data) {
    return data.keys().hasAll(['uid', 'displayName', 'score', 'correct', 'date', 'category'])
      && data.uid is string
      && data.score is int && data.score >= 0 && data.score <= 300
      && data.correct is int && data.correct >= 0 && data.correct <= 5
      && data.date is string && data.date.size() == 10
      && data.category in ['tarih', 'cografya', 'vatandaslik', 'guncel'];
  }

  // Düello taraf sonucu doğrulama (5 soru × maks 150 puan)
  function validDuelSide(score, correct) {
    return score is int && score >= 0 && score <= 750
      && correct is int && correct >= 0 && correct <= 5;
  }

  // Soru bildirimi doğrulama
  function validQuestionReportData(data) {
    return data.keys().hasAll(['uid', 'questionId', 'category', 'question', 'userAnswerIndex', 'correctIndex', 'reason'])
      && data.uid is string
      && data.questionId is string
      && data.category is string
      && data.question is string && data.question.size() <= 1000
      && data.userAnswerIndex is int
      && data.correctIndex is int
      && data.reason in ['wrong_answer', 'unclear', 'typo', 'other'];
  }

  // Quiz sonucu doğrulama
  function validResultData(data) {
    return data.keys().hasAll(['uid', 'displayName', 'score', 'correct', 'date', 'week'])
      && data.uid is string
      && data.score is int && data.score >= 0 && data.score <= 1500
      && data.correct is int && data.correct >= 0 && data.correct <= 10
      && data.date is string && data.date.size() == 10; // YYYY-MM-DD
  }
}
